# Maintainer: Your Name <your.email@example.com>
pkgname=openify-git
pkgver=2.0.0.r0.g7cee2f7
pkgrel=1
pkgdesc="A modern, lightweight music player powered by Tauri (Rust/Webview)."
arch=('x86_64')
url="https://github.com/Arcioth/openify"
license=('ISC')
depends=('webkit2gtk' 'gtk3' 'libappindicator-gtk3' 'yt-dlp')
makedepends=('git' 'nodejs>=18' 'npm' 'cargo' 'pkgconf')
provides=('openify')
conflicts=('openify')
source=('git+https://github.com/Arcioth/openify.git'
        'openify.desktop')
sha256sums=('SKIP'
            'SKIP')

pkgver() {
  cd "$srcdir/openify"
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "$srcdir/openify"
  npm install
  npm run tauri build
}

package() {
  cd "$srcdir/openify"
  
  # Install the binary
  install -Dm755 "src-tauri/target/release/openify" "$pkgdir/usr/bin/openify"
  
  # Install desktop entry
  install -Dm644 "$srcdir/openify.desktop" "$pkgdir/usr/share/applications/openify.desktop"
  
  # Install icon (Tauri icons)
  install -Dm644 "src-tauri/icons/128x128.png" "$pkgdir/usr/share/pixmaps/openify.png"
}
